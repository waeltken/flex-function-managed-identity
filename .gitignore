# Adapted from https://github.com/github/gitignore/blob/main/Terraform.gitignore
# and https://github.com/github/gitignore/blob/main/Python.gitignore

# Terraform local data, secrets, plans, and overrides
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Python environments, bytecode, builds, and tool caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[codz]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local credentials and Azure Functions development settings
.env
.env.*
!.env.example
local.settings.json

# Keep .terraform.lock.hcl and uv.lock tracked for reproducible dependencies.
